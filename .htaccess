RewriteEngine On

# Protect application/storage folders from direct browser access.
RewriteRule ^(?:app|storage)/ - [F,L]

# Existing files/folders pass through.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Pretty URLs: /packages, /login, /client/dashboard, etc.
RewriteRule ^ index.php [QSA,L]